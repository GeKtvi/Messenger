{
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/auth/{**rest}" }
      },
      "messages": {
        "ClusterId": "messages",
        "Match": { "Path": "/api/messages/{**rest}" }
      },
      "frontend": {
        "ClusterId": "frontend",
        "Match": { "Path": "/{**rest}" }
      }
    },
    "Clusters": {
      "identity": {
        "LoadBalancingPolicy": "RegionOrder"
      },
      "messages": {
        "LoadBalancingPolicy": "RegionOrder"
      },
      "frontend": {
        "Destinations": {
          "frontend": { "Address": "http://frontend:8080/" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*"
}
