@page "/"
@implements IDisposable
@inject MessageApiClient MessageApi
@inject MessageOutbox Outbox
@inject ISnackbar Snackbar

<PageTitle>Pingo</PageTitle>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <form @onsubmit="SendAsync">
        <MudStack Row AlignItems="AlignItems.Center">
            <MudTextField T="string"
                          @bind-Value="_text"
                          Label="Message"
                          Placeholder="Write something..."
                          Variant="Variant.Outlined"
                          Immediate
                          MaxLength="2000" />
            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       EndIcon="@Icons.Material.Filled.Send"
                       Disabled="@string.IsNullOrWhiteSpace(_text)">
                Send
            </MudButton>
        </MudStack>
    </form>
</MudPaper>

@if (_messages is null)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" />
}
else if (_messages.Count == 0 && !PendingToShow.Any())
{
    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
        No messages yet. Be the first!
    </MudText>
}
else
{
    <MudList T="string" Dense>
        @foreach (var message in _messages)
        {
            <MudListItem T="string" Icon="@Icons.Material.Filled.ChatBubbleOutline">
                <MudText Typo="Typo.body1">@message.Text</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @message.SentAt.ToLocalTime().ToString("g")
                    @if (message.UpdatedAt is { } updatedAt)
                    {
                        <span title="@updatedAt.ToLocalTime().ToString("g")"> · edited</span>
                    }
                </MudText>
            </MudListItem>
        }

        @foreach (var pending in PendingToShow)
        {
            var failed = pending.Status == PendingStatus.Failed;
            <MudListItem T="string"
                         Icon="@(failed ? Icons.Material.Filled.ErrorOutline : Icons.Material.Filled.Schedule)"
                         IconColor="@(failed ? Color.Error : Color.Default)"
                         Class="pending-message">
                <MudText Typo="Typo.body1" Style="opacity: 0.7">@pending.Text</MudText>
                <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                    @if (failed)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error">Not sent</MudText>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                   OnClick="() => Outbox.RetryAsync(pending)">Retry</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Text"
                                   OnClick="() => Outbox.DiscardAsync(pending)">Discard</MudButton>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Sending…</MudText>
                    }
                </MudStack>
            </MudListItem>
        }
    </MudList>
}

@code {
    private List<MessageDto>? _messages;
    private string _text = string.Empty;

    // A pending message can briefly also be in the server list (e.g. delivered just before
    // a reload); show it only once.
    private IEnumerable<PendingMessage> PendingToShow =>
        Outbox.Pending.Where(p => _messages?.Any(m => m.Id == p.Id) != true);

    protected override async Task OnInitializedAsync()
    {
        Outbox.Changed += OnOutboxChanged;
        Outbox.Delivered += OnDelivered;

        await LoadAsync();
        await Outbox.InitializeAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _messages = [.. await MessageApi.GetAllAsync()];
        }
        catch (HttpRequestException ex)
        {
            _messages = [];
            Snackbar.Add($"Could not load messages: {ex.Message}", Severity.Error);
        }
    }

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_text))
            return;

        var text = _text;
        _text = string.Empty;
        await Outbox.SendAsync(text);
    }

    private void OnOutboxChanged() => InvokeAsync(StateHasChanged);

    private void OnDelivered(MessageDto message)
    {
        if (_messages is null)
            return;

        _messages.RemoveAll(m => m.Id == message.Id);
        _messages.Add(message);
        _messages.Sort((a, b) => a.SentAt.CompareTo(b.SentAt));
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Outbox.Changed -= OnOutboxChanged;
        Outbox.Delivered -= OnDelivered;
    }
}
