{
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/auth/{**rest}" }
      },
      "messages": {
        "ClusterId": "messages",
        "Match": { "Path": "/api/messages/{**rest}" }
      },
      "frontend": {
        "ClusterId": "frontend",
        "Match": { "Path": "/{**rest}" }
      }
    },
    "Clusters": {
      "identity": {
        "LoadBalancingPolicy": "RegionOrder",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Path": "/health",
            "Interval": "00:00:01",
            "Timeout": "00:00:02",
            "Policy": "ConsecutiveFailures"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:10"
        },
        "Metadata": {
          "ConsecutiveFailuresHealthPolicy.Threshold": "2"
        }
      },
      "messages": {
        "LoadBalancingPolicy": "RegionOrder",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Path": "/health",
            "Interval": "00:00:01",
            "Timeout": "00:00:02",
            "Policy": "ConsecutiveFailures"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:10"
        },
        "Metadata": {
          "ConsecutiveFailuresHealthPolicy.Threshold": "2"
        }
      },
      "frontend": {
        "Destinations": {
          "frontend": { "Address": "http://frontend:8080/" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*"
}
